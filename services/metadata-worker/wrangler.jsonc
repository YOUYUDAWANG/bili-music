{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilimusic-metadata",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "METADATA_CACHE",
      "id": "1c9ea87a67f643c4bebcb0ac9edfeea5"
    }
  ],
  "vars": {
    "UPSTREAM_BASE_URL": "https://cpa.hachi-mi.uk",
    "MODEL": "gemini-3.7-flash-high",
    "PROMPT_VERSION": "music-metadata-v8-gemini-3.7-flash",
    "LYRIC_DIRECTOR_VERSION": "luna-lyric-director-v6-stage-gemini-3.7-flash",
    "LYRIC_DIRECTOR_V2_VERSION": "luna-lyric-director-v2-events-gemini-3.7-flash",
    "LYRIC_DIRECTOR_V3_VERSION": "luna-lyric-director-v3-whole-song-gemini-3.7-flash",
    "LYRIC_DIRECTOR_V3_ENABLED": "true",
    "LYRIC_DIRECTOR_V4_VERSION": "luna-lyric-director-v4-scene-recipe-gemini-3.7-flash",
    "LYRIC_DIRECTOR_V4_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}

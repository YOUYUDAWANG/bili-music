// 本地签名配置模板。
//
// 用法：复制本文件为 Local.xcconfig（已被 git 忽略），填入你自己的 Apple 开发者 Team ID，
// 然后运行 `xcodegen generate`。每个开发者各自维护，互不影响、不会再产生 project.yml 冲突。
//
// Team ID 查看方式：
//   - https://developer.apple.com/account 右上角
//   - 或 Xcode > Settings > Accounts > 选中账号 > 右下 Team 后面的括号内
//
// CI 不签名（CODE_SIGNING_ALLOWED=NO），会用本模板生成一个占位 Local.xcconfig，留空即可。
DEVELOPMENT_TEAM =

// 真机运行必须使用你自己 Apple Team 下可注册的唯一 Bundle ID。
// 如果 Xcode 报 “Failed Registering Bundle Identifier”，把这里改成更独特的值，
// 例如 com.<你的 GitHub 用户名小写>.BiliMusic 或 com.<你的域名反写>.BiliMusic。
BILIMUSIC_BUNDLE_ID = com.example.BiliMusic

// 歌曲清洗 Worker。URL 可直接使用默认值；访问令牌不要提交到 Git。
// 真机构建时建议从 macOS 钥匙串注入 BILIMUSIC_METADATA_API_KEY。
BILIMUSIC_METADATA_API_URL = https:/$()/bilimusic-metadata.mercari-email-sale-worker.workers.dev/v1/music/normalize
BILIMUSIC_METADATA_API_KEY =
